{
  "name": "@jryang1997/dsh-composer-dictation",
  "version": "1.5.1",
  "type": "module",
  "description": "Hold-to-talk dictation for the DeepSeek Harness composer: long-press the input box, release to transcribe into the draft",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "voice",
    "speech-to-text",
    "dictation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jryang1997/dsh-composer-dictation.git"
  },
  "homepage": "https://github.com/jryang1997/dsh-composer-dictation#readme",
  "bugs": {
    "url": "https://github.com/jryang1997/dsh-composer-dictation/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/locales.test.mjs && node tests/render.test.mjs",
    "check": "node --check index.js && node --check client.js && node tests/locales.test.mjs && node tests/render.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
